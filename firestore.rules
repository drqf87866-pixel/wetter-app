rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Orte: nur der eingeloggte Besitzer (uid) darf seine eigenen
    // Dokumente lesen, anlegen und löschen. Kein Zugriff auf fremde Orte.
    match /orte/{ortId} {
      allow read, delete: if request.auth != null
                           && request.auth.uid == resource.data.uid;

      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.uid;

      // Bearbeiten ist aktuell nicht vorgesehen (nur hinzufügen/löschen),
      // daher bewusst nicht erlaubt.
      allow update: if false;
    }
  }
}
